{#
 # ShowcaseKit feature-tree partial — sidebar navigation tree.
 #
 # Plain data-driven {% include %} replacement for the demo's
 # `component('demo-feature-tree')`. No PHP component: everything comes from
 # template variables. Class names match the demo so feature.css / nav.css apply.
 #
 # Variables (all optional unless noted):
 #   sections        (list)   REQUIRED when not using `layers`. A flat list of sections:
 #                            [{ key, label, sidebarLabel?, icon?, href?,
 #                               groups?: [{ key, label, featureCount?, features }],
 #                               features?: [{ slug, title, section?, href?, opensInNewTab? }] }]
 #   layers          (list)   Optional grouping above sections. Each layer:
 #                            { key, label, eyebrow?, href?, type?('feature-links'),
 #                              sections?: [...as above...],
 #                              features?: [{ section, slug, title, href?, opensInNewTab? }] }
 #   currentSection  (string) active section key (for active state)
 #   currentSlug     (string) active feature slug (for active state)
 #   navMode         (string) 'guided' hides non-active layers
 #   activeLayerKey  (string) which layer is active (guided mode)
 #
 # When `layers` is absent, `sections` is wrapped in a single implicit layer.
 #}
{% set _layers = layers|default(null) %}
{% if _layers is null %}
  {% set _layers = [{ key: '_root', label: null, type: 'sections', sections: sections|default([]) }] %}
{% endif %}

<nav class="feature-tree" aria-label="Feature navigation tree" data-feature-tree>
  {% for layer in _layers %}
    {% set isActiveLayer = activeLayerKey is defined and activeLayerKey ? activeLayerKey == layer.key : true %}
    {% set shouldHideLayer = navMode is defined and navMode == 'guided' and activeLayerKey is defined and activeLayerKey and not isActiveLayer %}
    <section class="feature-tree__layer{{ isActiveLayer ? ' feature-tree__layer--active' : '' }}{{ shouldHideLayer ? ' feature-tree__layer--hidden' : '' }}" data-layer-key="{{ layer.key }}">
      {% if layer.label is defined and layer.label %}
        <div class="feature-tree__layer-header">
          <a
            href="{{ layer.href|default('#') }}"
            class="feature-tree__overview-link feature-tree__overview-link--layer"
          >
            <span class="feature-tree__icon" aria-hidden="true">{{ layer.eyebrow|default(layer.label|slice(0, 2)) }}</span>
            <span class="feature-tree__label">{{ layer.label }}</span>
          </a>
        </div>
      {% endif %}

      {% if layer.type|default('') == 'feature-links' %}
        <ul class="feature-tree__feature-list">
          {% for feature in layer.features|default([]) %}
            <li class="feature-tree__feature-item{{ (currentSection|default('') == feature.section|default('') and currentSlug|default('') == feature.slug|default('')) ? ' feature-tree__feature-item--active' : '' }}">
              {% set opensInNewTab = feature.opensInNewTab|default(false) %}
              <a
                href="{{ feature.href|default('#') }}"
                class="feature-tree__link feature-tree__link--feature{{ (currentSection|default('') == feature.section|default('') and currentSlug|default('') == feature.slug|default('')) ? ' feature-tree__link--active' : '' }}"
                data-feature-slug="{{ feature.slug }}"
                data-feature-section="{{ feature.section|default('') }}"
                {% if opensInNewTab %}target="_blank" rel="noopener noreferrer" aria-label="{{ feature.title }} (opens in new tab)"{% endif %}
              >
                <span class="feature-tree__link-title">{{ feature.title }}</span>
                {% if opensInNewTab %}<span class="sk-external-indicator" aria-hidden="true">↗</span>{% endif %}
              </a>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <div class="feature-tree__layer-sections">
          {% for section in layer.sections|default([]) %}
            {% set sectionLabel = section.sidebarLabel|default(section.label) %}
            {% set sectionGroups = section.groups|default([]) %}
            {% if sectionGroups is empty and section.features|default([]) is not empty %}
              {% set sectionGroups = [{
                'key': section.key ~ '-overview',
                'label': 'Overview',
                'featureCount': section.features|length,
                'features': section.features
              }] %}
            {% endif %}
            <div class="feature-tree__section{{ currentSection|default('') == section.key ? ' feature-tree__section--active feature-tree__section--open' : '' }}" data-section-key="{{ section.key }}">
              <div class="feature-tree__header">
                <a
                  href="{{ section.href|default('#') }}"
                  class="feature-tree__overview-link{{ currentSection|default('') == section.key and (currentSlug|default('')) == '' ? ' feature-tree__overview-link--active' : '' }}"
                >
                  <span class="feature-tree__icon" aria-hidden="true">{{ section.icon|default('') }}</span>
                  <span class="feature-tree__label">{{ sectionLabel }}</span>
                </a>
                <button
                  class="feature-tree__toggle"
                  type="button"
                  aria-expanded="{{ currentSection|default('') == section.key ? 'true' : 'false' }}"
                  aria-controls="tree-{{ layer.key }}-{{ section.key }}"
                  aria-label="Toggle {{ sectionLabel }} section"
                >
                  <span class="feature-tree__toggle-glyph" aria-hidden="true">⌄</span>
                </button>
              </div>
              <div
                id="tree-{{ layer.key }}-{{ section.key }}"
                class="feature-tree__section-body"
                data-expanded="{{ currentSection|default('') == section.key ? 'true' : 'false' }}"
              >
                {% for group in sectionGroups %}
                  <div class="feature-tree__group">
                    <div class="feature-tree__group-header">
                      <span class="feature-tree__group-label">{{ group.label }}</span>
                    </div>
                    <ul class="feature-tree__group-list">
                      {% for feature in group.features|default([]) %}
                        <li class="feature-tree__item{{ (currentSection|default('') == section.key and currentSlug|default('') == feature.slug) ? ' feature-tree__item--active' : '' }}">
                          {% set opensInNewTab = feature.opensInNewTab|default(false) %}
                          <a
                            href="{{ feature.href|default('#') }}"
                            class="feature-tree__link"
                            data-feature-slug="{{ feature.slug }}"
                            {% if opensInNewTab %}target="_blank" rel="noopener noreferrer" aria-label="{{ feature.title }} (opens in new tab)"{% endif %}
                          >{{ feature.title }}{% if opensInNewTab %}<span class="sk-external-indicator" aria-hidden="true">↗</span>{% endif %}</a>
                        </li>
                      {% endfor %}
                    </ul>
                  </div>
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </section>
  {% endfor %}
</nav>
